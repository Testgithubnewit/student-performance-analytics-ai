# 9. G1 VS G3
# -----------------------------

plt.figure(figsize=(9, 6))

sns.scatterplot(
    data=df,
    x="G1",
    y="G3",
    color="darkorange",
    alpha=0.7
)

plt.title("First Period Grade (G1) vs Final Grade (G3)")
plt.xlabel("G1")
plt.ylabel("G3")

plt.tight_layout()
plt.show()


# -----------------------------
# 10. G2 VS G3
# -----------------------------

plt.figure(figsize=(9, 6))

sns.scatterplot(
    data=df,
    x="G2",
    y="G3",
    color="seagreen",
    alpha=0.7
)

plt.title("Second Period Grade (G2) vs Final Grade (G3)")
plt.xlabel("G2")
plt.ylabel("G3")

plt.tight_layout()
plt.show()


# -----------------------------
# 11. ABSENCES VS FINAL GRADE
# -----------------------------

plt.figure(figsize=(10, 6))

sns.scatterplot(
    data=df,
    x="absences",
    y="G3",
    color="crimson",
    alpha=0.7
)

plt.title("Absences vs Final Grade")
plt.xlabel("Number of Absences")
plt.ylabel("Final Grade (G3)")

plt.tight_layout()
plt.show()


# -----------------------------
# 12. GENDER ANALYSIS
# -----------------------------

plt.figure(figsize=(8, 6))

sns.boxplot(
    data=df,
    x="sex",
    y="G3",
    color="lightgreen"
)

plt.title("Final Grade Distribution by Gender")
plt.xlabel("Gender")
plt.ylabel("Final Grade (G3)")

plt.tight_layout()
plt.show()


# -----------------------------
# 13. INTERNET ACCESS ANALYSIS
# -----------------------------

plt.figure(figsize=(8, 6))

sns.boxplot(
    data=df,
    x="internet",
    y="G3",
    color="plum"
)

plt.title("Final Grade Distribution by Internet Access")
plt.xlabel("Internet Access")
plt.ylabel("Final Grade (G3)")

plt.tight_layout()
plt.show()


# -----------------------------
# 14. CORRELATION MATRIX
# -----------------------------

numeric_df = df.select_dtypes(include=np.number)

correlation_matrix = numeric_df.corr()

plt.figure(figsize=(14, 10))

sns.heatmap(
    correlation_matrix,
    cmap="coolwarm",
    center=0,
    annot=True,
    fmt=".2f",
    linewidths=0.5
)

plt.title("Correlation Matrix")

plt.tight_layout()
plt.show()


# -----------------------------
# 15. CORRELATION WITH G3
# -----------------------------

g3_correlations = (
    correlation_matrix["G3"]
    .drop("G3")
    .sort_values(key=lambda x: x.abs(), ascending=False)
)

print("\nCorrelation with Final Grade (G3)")
print("--------------------------------")

display(
    g3_correlations.to_frame(
        name="Correlation with G3"
    )
)


# -----------------------------
# 16. ANALYTICAL INSIGHTS
# -----------------------------

strongest_feature = g3_correlations.index[0]
strongest_correlation = g3_correlations.iloc[0]

print("\nAI-ASSISTED ANALYTICAL INSIGHTS")
print("=" * 60)

print(
    f"\nThe numerical variable with the strongest "
    f"absolute association with G3 is '{strongest_feature}', "
    f"with a correlation of {strongest_correlation:.3f}."
)

print(
    "\nCorrelation indicates statistical association "
    "and does not prove causation."
)

print(
    "\nPrevious-period grades G1 and G2 are examined "
    "separately because they are strongly related to "
    "the final grade."
)


# -----------------------------
# 17. PREPARE MACHINE-LEARNING DATA
# -----------------------------

# Final grade is the prediction target.
#
# G1 and G2 are excluded from the primary prediction
# experiment because they are previous-period grades.

X_model = df.drop(
    columns=["G3", "G1", "G2"]
)

y_model = df["G3"]

print("\nMachine-learning feature count:", X_model.shape[1])
print("Target records:", y_model.shape[0])


# -----------------------------
# 18. TRAIN-TEST SPLIT
# -----------------------------

X_train, X_test, y_train, y_test = train_test_split(
    X_model,
    y_model,
    test_size=0.20,
    random_state=RANDOM_STATE
)

print("\nTraining records:", len(X_train))
print("Testing records:", len(X_test))


# -----------------------------
# 19. IDENTIFY FEATURE TYPES
# -----------------------------

categorical_features = X_model.select_dtypes(
    include=["object", "category"]
).columns.tolist()

numerical_features = X_model.select_dtypes(
    include=np.number
).columns.tolist()

print("\nNumerical features:")
print(numerical_features)

print("\nCategorical features:")
print(categorical_features)


# -----------------------------
# 20. PREPROCESSING PIPELINE
# -----------------------------

numeric_pipeline = Pipeline(
    steps=[
        (
            "imputer",
            SimpleImputer(strategy="median")
        ),
        (
            "scaler",
            StandardScaler()
        )
    ]
)

categorical_pipeline = Pipeline(
    steps=[
        (
            "imputer",
            SimpleImputer(strategy="most_frequent")
        ),
        (
            "encoder",
            OneHotEncoder(handle_unknown="ignore")
        )
    ]
)

preprocessor = ColumnTransformer(
    transformers=[
        (
            "numeric",
            numeric_pipeline,
            numerical_features
        ),
        (
            "categorical",
            categorical_pipeline,
            categorical_features
        )
    ]
)


# -----------------------------
# 21. DEFINE MODELS
# -----------------------------

models = {
    "Linear Regression": LinearRegression(),

    "Decision Tree": DecisionTreeRegressor(
        max_depth=6,
        random_state=RANDOM_STATE
    ),

    "Random Forest": RandomForestRegressor(
        n_estimators=300,
        max_depth=10,
        random_state=RANDOM_STATE,
        n_jobs=-1
    ),

    "Gradient Boosting": GradientBoostingRegressor(
        n_estimators=200,
        learning_rate=0.05,
        max_depth=3,
        random_state=RANDOM_STATE
    )
}


# -----------------------------
# 22. TRAIN AND EVALUATE MODELS
# -----------------------------

results = []
trained_models = {}

for model_name, estimator in models.items():

    pipeline = Pipeline(
        steps=[
            ("preprocessor", preprocessor),
            ("model", estimator)
        ]
    )

    pipeline.fit(X_train, y_train)

    predictions = pipeline.predict(X_test)

    mae = mean_absolute_error(
        y_test,
        predictions
    )

    rmse = np.sqrt(
        mean_squared_error(
            y_test,
            predictions
        )
    )

    r2 = r2_score(
        y_test,
        predictions
    )

    results.append({
        "Model": model_name,
        "MAE": mae,
        "RMSE": rmse,
        "R2": r2
    })

    trained_models[model_name] = pipeline


results_df = pd.DataFrame(results)

results_df = results_df.sort_values(
    by="R2",
    ascending=False
).reset_index(drop=True)

print("\nMODEL EVALUATION RESULTS")
print("=" * 60)

display(results_df.round(4))


# -----------------------------
# 23. MODEL COMPARISON - R2
# -----------------------------

plt.figure(figsize=(11, 6))

sns.barplot(
    data=results_df,
    x="Model",
    y="R2",
    color="steelblue"
)

plt.title("Model Comparison - R² Score")
plt.xlabel("Model")
plt.ylabel("R² Score")

plt.xticks(rotation=20)

plt.tight_layout()
plt.show()


# -----------------------------
# 24. MODEL COMPARISON - MAE
# -----------------------------

plt.figure(figsize=(11, 6))

sns.barplot(
    data=results_df,
    x="Model",
    y="MAE",
    color="darkorange"
)

plt.title("Model Comparison - Mean Absolute Error")
plt.xlabel("Model")
plt.ylabel("MAE")

plt.xticks(rotation=20)

plt.tight_layout()
plt.show()


# -----------------------------
# 25. MODEL COMPARISON - RMSE
# -----------------------------

plt.figure(figsize=(11, 6))

sns.barplot(
    data=results_df,
    x="Model",
    y="RMSE",
    color="seagreen"
)

plt.title("Model Comparison - RMSE")
plt.xlabel("Model")
plt.ylabel("RMSE")

plt.xticks(rotation=20)

plt.tight_layout()
plt.show()


# -----------------------------
# 26. SELECT MODEL BASED ON TEST R2
# -----------------------------

best_model_name = results_df.iloc[0]["Model"]

best_model = trained_models[best_model_name]

best_mae = results_df.iloc[0]["MAE"]
best_rmse = results_df.iloc[0]["RMSE"]
best_r2 = results_df.iloc[0]["R2"]

print("\nSELECTED MODEL")
print("=" * 60)

print("Model:", best_model_name)
print("MAE:", round(best_mae, 4))
print("RMSE:", round(best_rmse, 4))
print("R²:", round(best_r2, 4))


# -----------------------------
# 27. ACTUAL VS PREDICTED
# -----------------------------

best_predictions = best_model.predict(X_test)

prediction_comparison = pd.DataFrame({
    "Actual G3": y_test.values,
    "Predicted G3": best_predictions
})

print("\nActual vs Predicted Values:")
display(
    prediction_comparison.head(15).round(2)
)


# -----------------------------
# 28. ACTUAL VS PREDICTED PLOT
# -----------------------------

plt.figure(figsize=(9, 7))

sns.scatterplot(
    x=y_test,
    y=best_predictions,
    color="purple",
    alpha=0.75
)

minimum = min(
    y_test.min(),
    best_predictions.min()
)

maximum = max(
    y_test.max(),
    best_predictions.max()
)

plt.plot(
    [minimum, maximum],
    [minimum, maximum],
    color="red",
    linestyle="--",
    label="Perfect Prediction"
)

plt.title(
    f"Actual vs Predicted Final Grade - {best_model_name}"
)

plt.xlabel("Actual G3")
plt.ylabel("Predicted G3")

plt.legend()

plt.tight_layout()
plt.show()


# -----------------------------
# 29. SAMPLE PREDICTION
# -----------------------------

sample_student = X_test.iloc[[0]]

actual_score = y_test.iloc[0]

predicted_score = best_model.predict(
    sample_student
)[0]

print("\nSAMPLE PREDICTION")
print("=" * 60)

print(
    "Actual Final Grade:",
    round(actual_score, 2)
)

print(
    "Predicted Final Grade:",
    round(predicted_score, 2)
)

print(
    "Absolute Prediction Error:",
    round(
        abs(actual_score - predicted_score),
        2
    )
)


# -----------------------------
# 30. RANDOM FOREST FEATURE IMPORTANCE
# -----------------------------

random_forest_model = trained_models["Random Forest"]

rf_preprocessor = (
    random_forest_model
    .named_steps["preprocessor"]
)

rf_estimator = (
    random_forest_model
    .named_steps["model"]
)

feature_names = (
    rf_preprocessor
    .get_feature_names_out()
)

importance_values = (
    rf_estimator.feature_importances_
)

feature_importance = pd.DataFrame({
    "Feature": feature_names,
    "Importance": importance_values
})

feature_importance = (
    feature_importance
    .sort_values(
        by="Importance",
        ascending=False
    )
    .head(15)
)

print("\nTOP RANDOM FOREST FEATURES")
print("=" * 60)

display(
    feature_importance
)


# -----------------------------
# 31. FEATURE IMPORTANCE CHART
# -----------------------------

plt.figure(figsize=(11, 7))

sns.barplot(
    data=feature_importance,
    x="Importance",
    y="Feature",
    color="teal"
)

plt.title("Top 15 Random Forest Feature Importances")
plt.xlabel("Feature Importance")
plt.ylabel("Feature")

plt.tight_layout()
plt.show()


# -----------------------------
# 32. FINAL AI-ASSISTED SUMMARY
# -----------------------------

top_feature = feature_importance.iloc[0]["Feature"]
top_importance = feature_importance.iloc[0]["Importance"]

print("\nFINAL PROJECT SUMMARY")
print("=" * 70)

print(
    f"\nThe evaluated model was {best_model_name}."
)

print(
    f"\nTest-set R² score: {best_r2:.3f}"
)

print(
    f"Test-set MAE: {best_mae:.3f}"
)

print(
    f"Test-set RMSE: {best_rmse:.3f}"
)

print(
    f"\nThe highest Random Forest feature importance "
    f"among the encoded features was associated with "
    f"'{top_feature}'."
)

print(
    "\nThese results describe patterns found in the "
    "selected dataset and should not be interpreted "
    "as proof of causation."
)

print(
    "\nMachine-learning predictions are estimates and "
    "should not be treated as definitive judgments "
    "about individual students."
)

print("\nProject execution completed successfully.")
